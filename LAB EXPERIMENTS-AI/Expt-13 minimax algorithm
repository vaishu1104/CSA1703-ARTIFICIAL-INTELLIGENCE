# Minimax Algorithm for Tic-Tac-Toe

board = ['X', 'O', 'X',
         ' ', 'O', ' ',
         ' ', ' ', 'X']

def win(p):
    lines = [(0,1,2), (3,4,5), (6,7,8),
             (0,3,6), (1,4,7), (2,5,8),
             (0,4,8), (2,4,6)]
    return any(board[a] == board[b] == board[c] == p
               for a, b, c in lines)

def minimax(maximizing):
    if win('O'):
        return 1
    if win('X'):
        return -1
    if ' ' not in board:
        return 0

    scores = []
    for i in range(9):
        if board[i] == ' ':
            board[i] = 'O' if maximizing else 'X'
            scores.append(minimax(not maximizing))
            board[i] = ' '

    return max(scores) if maximizing else min(scores)

best_score = -2
best_move = -1

for i in range(9):
    if board[i] == ' ':
        board[i] = 'O'
        score = minimax(False)
        board[i] = ' '

        if score > best_score:
            best_score = score
            best_move = i

print("Best move for AI:", best_move + 1)
