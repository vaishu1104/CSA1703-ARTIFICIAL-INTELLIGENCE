graph = {
    'A': {'B': 1, 'C': 3},
    'B': {'D': 3, 'E': 6},
    'C': {'F': 5},
    'D': {'G': 2},
    'E': {'G': 1},
    'F': {'G': 2},
    'G': {}
}

heuristic = {
    'A': 7,
    'B': 6,
    'C': 4,
    'D': 2,
    'E': 1,
    'F': 2,
    'G': 0
}

def astar(start, goal):
    open_list = [(heuristic[start], 0, start, [start])]
    visited = set()

    while open_list:
        open_list.sort()
        f, cost, node, path = open_list.pop(0)

        if node == goal:
            print("Shortest Path:", " -> ".join(path))
            print("Total Cost:", cost)
            return

        if node in visited:
            continue
        visited.add(node)

        for neighbor, weight in graph[node].items():
            if neighbor not in visited:
                g = cost + weight
                h = heuristic[neighbor]
                open_list.append((g + h, g, neighbor, path + [neighbor]))

start = input("Enter Start Node: ").upper()
goal = input("Enter Goal Node: ").upper()

astar(start, goal)
