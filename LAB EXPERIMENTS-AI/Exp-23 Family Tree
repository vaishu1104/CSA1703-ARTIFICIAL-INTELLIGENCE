male(ravi).
male(rajesh).
male(amit).

female(sita).
female(priya).
female(anu).

parent(ravi, rajesh).
parent(sita, rajesh).
parent(rajesh, amit).
parent(priya, amit).
parent(rajesh, anu).
parent(priya, anu).

father(X, Y) :-
    male(X),
    parent(X, Y).

mother(X, Y) :-
    female(X),
    parent(X, Y).

brother(X, Y) :-
    male(X),
    parent(P, X),
    parent(P, Y),
    X \= Y.

sister(X, Y) :-
    female(X),
    parent(P, X),
    parent(P, Y),
    X \= Y.
